{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mittelkap",
  "version": "0.1.0",
  "identifier": "de.mittelkap.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mittelkap - Sprachnachrichten in Text",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "dragDropEnabled": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
