{
  "name": "wo-was-filme-serien",
  "version": "1.0.0",
  "description": "Desktop-App zur Suche nach Streaming-Verfügbarkeiten weltweit (Electron + React)",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "concurrently \"npm:react-start\" \"npm:electron-start\"",
    "react-start": "cd renderer && npm start",
    "electron-start": "wait-on tcp:3000 && electron .",
    "build": "cd renderer && npm run build && electron-builder",
    "postinstall": "cd renderer && npm install"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.2.3",
    "electron-builder": "^24.6.0",
    "wait-on": "^7.0.1"
  }
}
