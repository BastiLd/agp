# MediaSync configuration (copy to .env or set in docker-compose)

# --- Web server ---
PORT=3000
HOST=0.0.0.0

# --- Login (leave AUTH_PASSWORD empty to disable login) ---
AUTH_PASSWORD=changeme
SESSION_SECRET=change-this-to-a-long-random-string
# COOKIE_SECURE=true   # only when served over HTTPS

# --- File ownership (NAS user; run `id` to find your values) ---
PUID=1000
PGID=1000

# --- Storage paths inside the container ---
CONFIG_DIR=/config
# Comma-separated roots the app may scan, rename and move within
MEDIA_ROOTS=/media

# --- Optional integrations (also settable in the UI) ---
TMDB_KEY=
PLEX_URL=
PLEX_TOKEN=

# Optional defaults for the rename feature
MOVIES_ROOT=
SERIES_ROOT=
