<UserControl x:Class="EverythingSelf.App.Views.EdgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:EverythingSelf.App.Common"
             Background="{StaticResource WindowBackground}">

    <UserControl.Resources>
        <common:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <common:EmptyStringToVisibilityConverter x:Key="TextToVisibility" />
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfbereich mit der Favicon-Erklärung -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Edge, WebView2 und der Update-Mechanismus"
                           Style="{StaticResource HeadingText}" />

                <Button Grid.Column="1"
                        Style="{StaticResource InfoButton}"
                        VerticalAlignment="Top"
                        Click="OnFaviconInfoClick" />

                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionText}"
                           Text="Hier stehen alle Edge-Bestandteile einzeln aufgeführt. Jede Karte erklärt über das Info-Symbol, was der Bestandteil ist, was die Aktion genau tut und wie sie sich rückgängig machen lässt. Ausgeführt wird ausschließlich, was ausdrücklich bestätigt wird. Warum trotz allem noch Favicons geladen werden, erklärt das Info-Symbol oben rechts." />
            </Grid>
        </Border>

        <!-- Sicherheitsschalter -->
        <Border Grid.Row="1"
                Background="#33E0A44A"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,11"
                Margin="0,0,0,14">
            <CheckBox IsChecked="{Binding Understood}">
                <TextBlock TextWrapping="Wrap"
                           Text="Ich habe verstanden, dass diese Eingriffe in Windows-Bestandteile eingreifen und jeweils eine Rückfrage von Windows (UAC) auslösen. Erst mit diesem Haken werden die Schaltflächen aktiv." />
            </CheckBox>
        </Border>

        <!-- Komponentenliste -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Components}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingText}" />
                                    <Border Background="{StaticResource SurfaceRaised}"
                                            CornerRadius="9"
                                            Padding="8,2"
                                            Margin="10,1,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PresenceLabel}"
                                                   Style="{StaticResource CaptionText}"
                                                   FontSize="11" />
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Style="{StaticResource InfoButton}"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Top"
                                        Tag="{Binding}"
                                        Click="OnComponentInfoClick" />

                                <Button Grid.Column="2"
                                        Content="{Binding ActionTitle}"
                                        Margin="12,0,0,0"
                                        MinWidth="200"
                                        VerticalAlignment="Top"
                                        Tag="{Binding}"
                                        Click="OnActionClick"
                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"
                                        IsEnabled="{Binding DataContext.ActionsEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                                           Text="{Binding StatusText}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0" />

                                <TextBlock Grid.Row="2" Grid.ColumnSpan="3"
                                           Text="{Binding Location}"
                                           Style="{StaticResource CaptionText}"
                                           FontFamily="Consolas, Courier New"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding Location, Converter={StaticResource TextToVisibility}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Fußzeile -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <Button Grid.Column="1"
                    Content="Erneut prüfen"
                    Command="{Binding RefreshCommand}" />
        </Grid>
    </Grid>
</UserControl>
