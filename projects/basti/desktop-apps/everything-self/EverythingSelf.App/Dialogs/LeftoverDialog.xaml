<Window x:Class="EverythingSelf.App.Dialogs.LeftoverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:EverythingSelf.App.Common"
        Title="Übrig gebliebene Reste"
        Width="900"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}">

    <Window.Resources>
        <common:SizeConverter x:Key="SizeConverter" />
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingBlock"
                   Style="{StaticResource HeadingText}"
                   FontSize="17"
                   TextWrapping="Wrap" />

        <Border Grid.Row="1"
                Background="#332F80ED"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,11"
                Margin="0,14,0,0">
            <TextBlock TextWrapping="Wrap">
                <Run Text="Vorausgewählt sind nur eindeutige Treffer." />
                <LineBreak />
                <Run Text="Einträge mit der Bewertung &quot;prüfen&quot; könnten auch zu einem anderen Programm gehören - bitte vor dem Entfernen kurz ansehen. Dateien und Ordner wandern in den Papierkorb, Registry-Schlüssel werden endgültig gelöscht."
                     Foreground="{StaticResource TextSecondary}" />
            </TextBlock>
        </Border>

        <DataGrid x:Name="ItemsGrid"
                  Grid.Row="2"
                  Margin="0,14,0,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header=""
                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                        Width="42" />
                <DataGridTextColumn Header="Art" Binding="{Binding KindLabel}" Width="200" IsReadOnly="True" />
                <DataGridTextColumn Header="Bewertung" Binding="{Binding ConfidenceLabel}" Width="95" IsReadOnly="True" />
                <DataGridTextColumn Header="Pfad" Binding="{Binding Path}" Width="3*" IsReadOnly="True" />
                <DataGridTextColumn Header="Größe"
                                    Binding="{Binding SizeBytes, Converter={StaticResource SizeConverter}}"
                                    Width="95"
                                    IsReadOnly="True" />
            </DataGrid.Columns>

            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Reason}"
                               Style="{StaticResource CaptionText}"
                               Margin="52,2,10,8"
                               TextWrapping="Wrap" />
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusBlock"
                       Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Nichts entfernen"
                        MinWidth="150"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="OnSkipClick" />
                <Button x:Name="RemoveButton"
                        Content="Ausgewählte entfernen"
                        Style="{StaticResource DangerButton}"
                        MinWidth="200"
                        Click="OnRemoveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
