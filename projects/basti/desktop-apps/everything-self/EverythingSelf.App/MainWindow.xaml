<Window x:Class="EverythingSelf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EverythingSelf.App.Views"
        Title="Everything Self - Suchen, Deinstallieren, Aufräumen"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">

    <DockPanel>
        <!-- Kopfzeile -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBackground}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Everything Self"
                               Style="{StaticResource HeadingText}"
                               FontSize="17" />
                    <TextBlock x:Name="SubtitleBlock"
                               Style="{StaticResource CaptionText}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Über dieses Programm"
                        Click="OnAboutClick" />
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Padding="0">
            <TabItem Header="Suche">
                <views:SearchView x:Name="SearchTab" />
            </TabItem>
            <TabItem Header="Programme">
                <views:UninstallView x:Name="UninstallTab" />
            </TabItem>
            <TabItem Header="Edge &amp; WebView2">
                <views:EdgeView x:Name="EdgeTab" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
