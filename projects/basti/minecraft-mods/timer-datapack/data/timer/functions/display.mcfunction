# Display timer with different colors
execute if score #timer_color timer matches 0 run title @a actionbar {"text":"Timer: ","color":"gold","extra":[{"score":{"name":"#timer_minutes","objective":"timer"},"color":"yellow"},{"text":":","color":"gold"},{"score":{"name":"#timer_seconds","objective":"timer"},"color":"yellow"}]}
execute if score #timer_color timer matches 1 run title @a actionbar {"text":"Timer: ","color":"aqua","extra":[{"score":{"name":"#timer_minutes","objective":"timer"},"color":"light_purple"},{"text":":","color":"aqua"},{"score":{"name":"#timer_seconds","objective":"timer"},"color":"light_purple"}]}
execute if score #timer_color timer matches 2 run title @a actionbar {"text":"Timer: ","color":"green","extra":[{"score":{"name":"#timer_minutes","objective":"timer"},"color":"lime"},{"text":":","color":"green"},{"score":{"name":"#timer_seconds","objective":"timer"},"color":"lime"}]}
execute if score #timer_color timer matches 3 run title @a actionbar {"text":"Timer: ","color":"red","extra":[{"score":{"name":"#timer_minutes","objective":"timer"},"color":"dark_red"},{"text":":","color":"red"},{"score":{"name":"#timer_seconds","objective":"timer"},"color":"dark_red"}]} 