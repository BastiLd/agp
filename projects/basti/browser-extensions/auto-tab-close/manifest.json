{
  "manifest_version": 3,
  "name": "Auto Tab Close",
  "description": "Schließt neue Tabs und Fenster automatisch nach globalen oder website-spezifischen Regeln.",
  "version": "1.0.0",
  "permissions": [
    "tabs",
    "storage",
    "history"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Auto Tab Close",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
