{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "Privacy Guard",
  "description": "__MSG_extensionDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "alarms",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Privacy Guard",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "cosmetic/*.json",
        "assets/*.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_static",
        "enabled": true,
        "path": "rules/ads_static.json"
      },
      {
        "id": "privacy_static",
        "enabled": true,
        "path": "rules/privacy_static.json"
      },
      {
        "id": "regional_de_static",
        "enabled": true,
        "path": "rules/regional_de_static.json"
      },
      {
        "id": "cookies_static",
        "enabled": true,
        "path": "rules/cookies_static.json"
      },
      {
        "id": "youtube_static",
        "enabled": true,
        "path": "rules/youtube_static.json"
      },
      {
        "id": "annoyances_static",
        "enabled": true,
        "path": "rules/annoyances_static.json"
      },
      {
        "id": "security_static",
        "enabled": true,
        "path": "rules/security_static.json"
      },
      {
        "id": "url_tracking_static",
        "enabled": false,
        "path": "rules/url_tracking_static.json"
      },
      {
        "id": "security_plus_static",
        "enabled": false,
        "path": "rules/security_plus_static.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/common/constants.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/common/constants.js",
        "src/content/youtube.js"
      ],
      "css": [
        "src/content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
